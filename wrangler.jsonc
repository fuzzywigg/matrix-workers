{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matrix-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Remove account_id — wrangler uses the authenticated account automatically.
  // Set via: wrangler login

  "observability": {
    "enabled": true
  },

  // D1 Database for relational data (users, rooms, events, memberships)
  // Replace database_id with the ID from: wrangler d1 create matrix-db
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matrix-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  // KV Namespaces for fast lookups
  // Replace each id with output from: wrangler kv namespace create <BINDING>
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "REPLACE_WITH_SESSIONS_KV_ID"
    },
    {
      "binding": "DEVICE_KEYS",
      "id": "REPLACE_WITH_DEVICE_KEYS_KV_ID"
    },
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_CACHE_KV_ID"
    },
    {
      "binding": "CROSS_SIGNING_KEYS",
      "id": "REPLACE_WITH_CROSS_SIGNING_KEYS_KV_ID"
    },
    {
      "binding": "ACCOUNT_DATA",
      "id": "REPLACE_WITH_ACCOUNT_DATA_KV_ID"
    },
    {
      "binding": "ONE_TIME_KEYS",
      "id": "REPLACE_WITH_ONE_TIME_KEYS_KV_ID"
    }
  ],

  // R2 Bucket for media storage
  // Replace bucket_name with the name from: wrangler r2 bucket create matrix-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "matrix-media"
    }
  ],

  // Durable Objects for real-time sync and room coordination
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      },
      {
        "name": "SYNC",
        "class_name": "SyncDurableObject"
      },
      {
        "name": "FEDERATION",
        "class_name": "FederationDurableObject"
      },
      {
        "name": "CALL_ROOMS",
        "class_name": "CallRoomDurableObject"
      },
      {
        "name": "ADMIN",
        "class_name": "AdminDurableObject"
      },
      {
        "name": "USER_KEYS",
        "class_name": "UserKeysDurableObject"
      },
      {
        "name": "PUSH",
        "class_name": "PushDurableObject"
      },
      {
        "name": "RATE_LIMIT",
        "class_name": "RateLimitDurableObject"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject", "SyncDurableObject", "FederationDurableObject"]
    },
    {
      "tag": "v2",
      "new_classes": ["CallRoomDurableObject"]
    },
    {
      "tag": "v3",
      "new_classes": ["AdminDurableObject"]
    },
    {
      "tag": "v4",
      "new_classes": ["UserKeysDurableObject"]
    },
    {
      "tag": "v5",
      "new_classes": ["PushDurableObject"]
    },
    {
      "tag": "v6",
      "new_classes": ["RateLimitDurableObject"]
    }
  ],

  // Environment variables — customize for your deployment
  "vars": {
    // Set to your Matrix server domain (e.g. "matrix.fuzzywigg.com")
    "SERVER_NAME": "matrix.example.com",
    "SERVER_VERSION": "0.1.0",
    // TURN server config — replace with your TURN credentials or remove if unused
    "TURN_KEY_ID": "REPLACE_WITH_YOUR_TURN_KEY_ID",
    // LiveKit config — replace with your LiveKit deployment or remove if unused
    "LIVEKIT_API_KEY": "REPLACE_WITH_YOUR_LIVEKIT_API_KEY",
    "LIVEKIT_URL": "wss://REPLACE_WITH_YOUR_LIVEKIT_URL"
  },

  // Required secrets — set using wrangler secret put <NAME>
  // wrangler secret put SIGNING_KEY        # openssl rand -base64 32
  // wrangler secret put OIDC_ENCRYPTION_KEY # openssl rand -base64 32
  // wrangler secret put TURN_API_TOKEN     # From your TURN provider
  // wrangler secret put CALLS_APP_ID       # Cloudflare Realtime App ID (optional)
  // wrangler secret put CALLS_APP_SECRET   # Cloudflare Realtime App Secret (optional)
  // wrangler secret put LIVEKIT_API_SECRET # LiveKit API secret (optional)
  // wrangler secret put EMAIL_FROM         # e.g. "noreply@matrix.example.com" (optional)

  // Custom domain routing — update pattern to your domain
  // Remove this section and configure via Cloudflare dashboard instead if preferred
  // "routes": [
  //   {
  //     "pattern": "matrix.example.com",
  //     "custom_domain": true
  //   }
  // ],

  // Workers VPC for LiveKit connectivity (optional)
  // Replace service_id with your VPC service ID from Cloudflare dashboard
  // Remove this binding if not using LiveKit via VPC
  "vpc_services": [
    {
      "binding": "LIVEKIT_API",
      "service_id": "REPLACE_WITH_YOUR_VPC_SERVICE_ID"
    }
  ],

  // Cloudflare Email Service for 3PID email verification (optional)
  "send_email": [{ "name": "EMAIL", "remote": true }],

  // Cloudflare Workflows for durable multi-step operations
  "workflows": [
    {
      "name": "room-join-workflow",
      "binding": "ROOM_JOIN_WORKFLOW",
      "class_name": "RoomJoinWorkflow"
    },
    {
      "name": "push-notification-workflow",
      "binding": "PUSH_NOTIFICATION_WORKFLOW",
      "class_name": "PushNotificationWorkflow"
    }
  ]
}
