{
  "name": "matrix-worker",
  "version": "0.1.0",
  "description": "Matrix homeserver running on Cloudflare Workers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute matrix-db --file=./migrations/schema.sql --remote",
    "db:migrate:local": "wrangler d1 execute matrix-db --local --file=./migrations/schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:media-presence-soft-concurrent": "vitest run test/media-api-concurrent-race-leftovers.test.ts test/media-api-soft-residual-second-wave-concurrent-race-leftovers.test.ts test/media-api-soft-residual-third-wave-concurrent-race-leftovers.test.ts test/media-api-soft-residual-fourth-wave-concurrent-race-leftovers.test.ts test/media-api-soft-residual-fifth-wave-concurrent-race-leftovers.test.ts test/media-api-soft-residual-sixth-wave-concurrent-race-leftovers.test.ts test/media-api-soft-residual-seventh-wave-concurrent-race-leftovers.test.ts test/media-api-soft-residual-eighth-wave-concurrent-race-leftovers.test.ts test/presence-receipts-typing-concurrent-soft-leftovers.test.ts test/presence-receipts-typing-soft-residual-second-wave-concurrent-race-leftovers.test.ts test/presence-receipts-typing-soft-residual-third-wave-concurrent-race-leftovers.test.ts test/presence-receipts-typing-soft-residual-fourth-wave-concurrent-race-leftovers.test.ts test/presence-receipts-typing-soft-residual-fifth-wave-concurrent-race-leftovers.test.ts test/presence-receipts-typing-soft-residual-sixth-wave-concurrent-race-leftovers.test.ts test/presence-receipts-typing-soft-residual-seventh-wave-concurrent-race-leftovers.test.ts test/presence-receipts-typing-soft-residual-eighth-wave-concurrent-race-leftovers.test.ts",
    "test:crypto-db": "vitest run test/crypto.test.ts test/database-crud-helpers.test.ts test/database-notify-authchain.test.ts test/validate-event-size.test.ts test/errors.test.ts",
    "test:filters-appservice-auth": "vitest run test/filters-appservice-auth-septenary-concurrent-race-leftovers.test.ts test/filters-appservice-auth-octonary-concurrent-race-leftovers.test.ts test/filters-appservice-auth-nonary-concurrent-race-leftovers.test.ts test/filters-appservice-auth-denary-concurrent-race-leftovers.test.ts test/filters-appservice-auth-undecenary-concurrent-race-leftovers.test.ts test/filters-appservice-auth-duodenary-concurrent-race-leftovers.test.ts",
    "test:admin-federation": "vitest run test/admin-api-quinary-concurrent-race-leftovers.test.ts test/admin-api-senary-concurrent-race-leftovers.test.ts test/admin-api-octonary-concurrent-race-leftovers.test.ts test/admin-api-nonary-concurrent-race-leftovers.test.ts test/admin-api-denary-concurrent-race-leftovers.test.ts test/federation-api-quinary-concurrent-race-leftovers.test.ts test/federation-api-senary-concurrent-race-leftovers.test.ts test/federation-api-octonary-concurrent-race-leftovers.test.ts test/federation-api-nonary-concurrent-race-leftovers.test.ts test/federation-api-denary-concurrent-race-leftovers.test.ts",
    "test:turn-concurrent": "vitest run test/turn-concurrent-race-leftovers.test.ts test/turn-second-wave-concurrent-race-leftovers.test.ts test/turn-third-wave-concurrent-race-leftovers.test.ts test/turn-fourth-wave-concurrent-race-leftovers.test.ts",
    "test:oauth-devices": "vitest run test/oauth-api-denary-concurrent-race-leftovers.test.ts test/oauth-api-undecenary-concurrent-race-leftovers.test.ts test/oauth-api-duodenary-concurrent-race-leftovers.test.ts test/oauth-api-tridecenary-concurrent-race-leftovers.test.ts test/devices-keys-soft-residual-seventh-wave-concurrent-race-leftovers.test.ts test/devices-keys-soft-residual-eighth-wave-concurrent-race-leftovers.test.ts test/devices-keys-soft-residual-ninth-wave-concurrent-race-leftovers.test.ts test/devices-keys-soft-residual-tenth-wave-concurrent-race-leftovers.test.ts",
    "test:room-cache": "vitest run test/room-cache-tridecenary-concurrent-race-leftovers.test.ts test/room-cache-quattuordecenary-concurrent-race-leftovers.test.ts test/room-cache-quindecenary-concurrent-race-leftovers.test.ts test/room-cache-sexdecenary-concurrent-race-leftovers.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/",
    "worker:check": "wrangler deploy --dry-run --outdir=.wrangler-dry-run"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "hono": "^4.13.7",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
