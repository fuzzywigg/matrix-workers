{
  "name": "matrix-worker",
  "version": "0.1.0",
  "description": "Matrix homeserver running on Cloudflare Workers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute matrix-db --file=./migrations/schema.sql --remote",
    "db:migrate:local": "wrangler d1 execute matrix-db --local --file=./migrations/schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:crypto-db": "vitest run test/crypto.test.ts test/database-crud-helpers.test.ts test/database-notify-authchain.test.ts test/validate-event-size.test.ts test/errors.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/",
    "worker:check": "wrangler deploy --dry-run --outdir=.wrangler-dry-run"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "hono": "^4.13.7",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
